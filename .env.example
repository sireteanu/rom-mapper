# Copy to .env and adjust for your system. .env is git-ignored.

# Folder on the host that contains Rom_Mapping.csv
CONFIG_DIR=/path/to/appdata/rom-mapper

# The one folder mounted into the container (at the same path). Everything below must be inside it:
# source folders, the mapping folder and RomM's download folders. On Unraid /mnt/user covers all shares.
EMULATION_ROOT=/mnt/user
# First source folder for the grid (add more, and how deep to look, under "Source folders" in the UI)
ROMS_PATH=/path/to/roms
MAPPING_PATH=/path/to/mapping

# RomM (optional): download folders, ";"-separated (or set them in the RomM dialog).
# The first one wins when two give the same platform.
ROMM_SOURCE=/path/to/downloads/lolroms;/path/to/downloads/rommer

# User/group that should own the created links (Unraid: 99/100)
PUID=99
PGID=100

# Web UI port on the host
WEBUI_PORT=8085
TZ=America/New_York
