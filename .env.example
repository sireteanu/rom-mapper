# Copy to .env and adjust for your system. .env is git-ignored.

# Folder on the host that contains Rom_Mapping.csv
CONFIG_DIR=/path/to/appdata/rom-mapper

# Parent folder of both ROMS_PATH and MAPPING_PATH (mounted 1:1 into the container)
EMULATION_ROOT=/path/to/shares
ROMS_PATH=/path/to/roms
MAPPING_PATH=/path/to/mapping

# RomM (optional): folder holding the lolroms download folder, and the download folder itself.
# RomM's platform links are created in ROMM_ROOT, next to the download folder.
ROMM_ROOT=/path/to/downloads
# several download folders: separate with ";" (first = preferred when two give the same platform)
ROMM_SOURCE=/path/to/downloads/lolroms;/path/to/downloads/rommer

# User/group that should own the created links (Unraid: 99/100)
PUID=99
PGID=100

# Web UI port on the host
WEBUI_PORT=8085
TZ=America/New_York
