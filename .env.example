# Copy to .env and adjust for your system. .env is git-ignored.

# Folder on the host that contains Rom_Mapping.csv
CONFIG_DIR=/path/to/appdata/rom-mapper

# Parent folder of both ROMS_PATH and MAPPING_PATH (mounted 1:1 into the container)
EMULATION_ROOT=/path/to/shares
ROMS_PATH=/path/to/roms
MAPPING_PATH=/path/to/mapping

# User/group that should own the created links (Unraid: 99/100)
PUID=99
PGID=100
