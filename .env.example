# Copy to .env and adjust for your system. .env is git-ignored.

# Host folder for the app's settings and mapping (mounted as /config)
CONFIG_DIR=/path/to/appdata/rom-mapper

# The one folder mounted into the container at the same path. Everything below must be inside it:
# source folders, the mapping folder and RomM's download folders.
EMULATION_ROOT=/path/to/shares
# First source folder (add more, and how deep to look, under "Source folders" in the page)
ROMS_PATH=/path/to/shares/roms
# Where the frontend folders of links are made
MAPPING_PATH=/path/to/shares/mapping

# RomM (optional): download folders, ";"-separated (or set them in the RomM dialog).
# The first one wins when two give the same platform.
ROMM_SOURCE=/path/to/shares/downloads

# RomM's download folders are NOT inside EMULATION_ROOT? Mount a second folder (same path) that
# HOLDS them - RomM's platform links are made next to the download folders, inside this folder.
# Uncomment both lines; ROMM_SOURCE (above) then points inside it, e.g. /path/to/downloads/lolroms.
#ROMM_ROOT=/path/to/downloads
#COMPOSE_FILE=docker-compose.yml:docker-compose.romm.yml

# User/group that should own the created links (Unraid: 99/100)
PUID=99
PGID=100

# Web UI port on the host
WEBUI_PORT=8085
TZ=America/New_York
